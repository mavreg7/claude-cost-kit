{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/target/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/Library/**)",
      "Read(**/Temp/**)",
      "Read(**/Logs/**)",
      "Read(**/*.lock)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/*.log)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/*.map)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/hooks/trim_bash.py\""}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/hooks/usage.py\" check"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/hooks/usage.py\" record"}]}
    ]
  }
}
